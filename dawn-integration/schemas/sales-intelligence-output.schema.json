{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawn.local/schemas/meeting-sales-intelligence-output-v1.json",
  "title": "DAWN Meeting Command Sales Intelligence Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meeting_id", "status", "summary", "actions", "evidence", "external_actions_performed"],
  "properties": {
    "schema_version": {"const": 1},
    "meeting_id": {"type": "string"},
    "status": {"enum": ["success", "partial", "blocked", "failed"]},
    "summary": {"type": "string", "maxLength": 6000},
    "pains": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 1000}},
    "requirements": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 1000}},
    "objections": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 1000}},
    "buying_signals": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 1000}},
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "owner", "evidence_refs"],
        "properties": {
          "action": {"type": "string", "maxLength": 1000},
          "owner": {"type": "string", "maxLength": 200},
          "deadline": {"type": ["string", "null"], "format": "date-time"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "follow_up_draft": {"type": ["string", "null"], "maxLength": 12000},
    "crm_payload": {"type": ["object", "null"]},
    "opportunity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "external_actions_performed": {"const": false}
  }
}
